# 이 파일을 복사해 .env를 만들고 값을 바꾸세요:  cp .env.example .env
# .env는 Git에 올리지 않습니다.

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- PostgreSQL ----------
# 비워 두면(주석 처리) 로컬 연습용 SQLite를 사용합니다. Docker Compose에서는 반드시 설정.
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis · Celery ----------
CELERY_BROKER_URL=redis://redis:6379/0

# ---------- FastAPI AI 서버 ----------
FASTAPI_URL=http://fastapi:8001
FASTAPI_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=100

# ---------- IP Webcam (허용 목록) ----------
# 형식: 키|화면에 보일 이름|영상 주소   (여러 개는 쉼표로 구분)
# 휴대폰 IP Webcam 앱 예: phone|내 휴대폰|http://192.168.0.10:8080/video
# 테스트용 가짜 카메라(tools/fake_ipwebcam.py, 호스트에서 실행): demo|테스트 스트림|http://host.docker.internal:8090/video
IP_WEBCAM_CAMERAS=phone|내 휴대폰|http://192.168.0.10:8080/video
IP_WEBCAM_CAPTURE_SECONDS=8
IP_WEBCAM_CONNECT_TIMEOUT=10

# ---------- AI 서버 ----------
# auto: GPU가 있으면 GPU, 없으면 CPU (Docker 이미지는 CPU용 torch)
POSE_DEVICE=auto
MAX_FRAMES=900
